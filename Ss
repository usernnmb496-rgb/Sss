-- ฟังก์ชันยิงระเบิด
local function FireBomb(Radius, TimeLength, ImpactSpeed, MaxForce, PosX, PosY, PosZ)
	local args = {
		{
			Radius = Radius or 17.5,
			TimeLength = TimeLength or 0.5,
			Hitbox = Instance.new("Part", nil),
			ExplodesByFire = true,
			MaxForcePerStudSquared = MaxForce or 225,
			Model = Instance.new("Model", nil),
			ImpactSpeed = ImpactSpeed or 100,
			ExplodesByPointy = false,
			DestroysModel = true,
			PositionPart = Instance.new("Part", nil)
		},
		vector.create(PosX or 342.666, PosY or -7.611, PosZ or -345.335)
	}
	game:GetService("ReplicatedStorage"):WaitForChild("BombEvents"):WaitForChild("BombExplode"):FireServer(unpack(args))
end

